<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_now_playing"
    android:padding="20dp">

    <ImageButton
        android:id="@+id/npBack"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_chip"
        android:padding="10dp"
        android:src="@android:drawable/ic_media_previous"
        app:tint="@color/textPrimary" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="28dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/npArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surfaceElevated"
            android:padding="48dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_note"
            app:tint="@color/accent" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/npTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:textColor="@color/textPrimary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/npArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/textSecondary"
        android:textSize="14sp" />

    <SeekBar
        android:id="@+id/npSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:progressTint="@color/accent"
        android:thumbTint="@color/accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/npPrev"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@color/textPrimary" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginHorizontal="24dp"
            app:cardBackgroundColor="@color/accent"
            app:cardCornerRadius="38dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp">

            <ImageButton
                android:id="@+id/npPlayPause"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:padding="20dp"
                android:src="@android:drawable/ic_media_play"
                app:tint="@color/textPrimary" />
        </com.google.android.material.card.MaterialCardView>

        <ImageButton
            android:id="@+id/npNext"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_next"
            app:tint="@color/textPrimary" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/npAddToPlaylist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingVertical="12dp"
        android:text="Add to Playlist"
        android:textAllCaps="false"
        android:textStyle="bold"
        app:backgroundTint="@color/accentSecondary"
        app:cornerRadius="16dp" />

</LinearLayout>
