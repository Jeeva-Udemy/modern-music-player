<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted-glass panel: soft top-to-bottom sheen with a thin bright rim. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/glassFillTop"
        android:endColor="@color/glassFillBottom" />
    <stroke android:width="1dp" android:color="@color/glassStroke" />
    <corners android:radius="22dp" />
</shape>
