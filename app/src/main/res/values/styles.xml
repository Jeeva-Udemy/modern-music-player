<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.MusicPlayer.Tab" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Dropdown menus (sort, song ⋮ menus, playlist card menus) -->
    <style name="Widget.MusicPlayer.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_dropdown</item>
        <item name="android:popupElevation">12dp</item>
        <item name="android:dropDownVerticalOffset">6dp</item>
        <item name="overlapAnchor">false</item>
    </style>

    <style name="TextAppearance.MusicPlayer.PopupMenu" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Dialogs (add to playlist, rename, confirmations) -->
    <style name="ThemeOverlay.MusicPlayer.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSurface">@color/surfaceDark</item>
        <item name="colorOnSurface">@color/textPrimary</item>
        <item name="alertDialogStyle">@style/MaterialAlertDialog.MusicPlayer</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.MusicPlayer.Title</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.MusicPlayer.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.MusicPlayer.DialogButton.Secondary</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.MusicPlayer.DialogButton.Secondary</item>
    </style>

    <style name="MaterialAlertDialog.MusicPlayer" parent="MaterialAlertDialog.Material3">
        <item name="backgroundTint">@color/dropdownFill</item>
        <item name="shapeAppearance">@style/ShapeAppearance.MusicPlayer.Dialog</item>
    </style>

    <style name="MaterialAlertDialog.MusicPlayer.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShapeAppearance.MusicPlayer.Dialog" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">26dp</item>
    </style>

    <style name="Widget.MusicPlayer.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.MusicPlayer.DialogButton.Secondary">
        <item name="android:textColor">@color/textSecondary</item>
    </style>
</resources>
