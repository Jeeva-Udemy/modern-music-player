<?xml version="1.0" encoding="utf-8"?>
<!-- Floating glass mini player. The outer FrameLayout provides the margin so
     the bar works both in ConstraintLayout and LinearLayout hosts. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/miniPlayerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_mini_player"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="10dp">

        <SeekBar
            android:id="@+id/miniSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardBackgroundColor="@color/surfaceElevated"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/glassStroke"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/miniArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_music_note" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nowPlayingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Nothing playing"
                    android:textColor="@color/textPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/nowPlayingArtist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/miniVolumeButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volume"
                android:padding="7dp"
                android:src="@drawable/ic_volume_up"
                app:tint="@color/textPrimary" />

            <ImageButton
                android:id="@+id/prevButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous"
                android:padding="6dp"
                android:src="@drawable/ic_skip_previous"
                app:tint="@color/textPrimary" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/miniPlayPauseCard"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginHorizontal="2dp"
                app:cardBackgroundColor="@color/accent"
                app:cardCornerRadius="23dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/glassStroke"
                app:strokeWidth="1dp">

                <ImageButton
                    android:id="@+id/playPauseButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:contentDescription="Play or pause"
                    android:padding="11dp"
                    android:src="@drawable/ic_play"
                    app:tint="@color/onAccent" />
            </com.google.android.material.card.MaterialCardView>

            <ImageButton
                android:id="@+id/nextButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next"
                android:padding="6dp"
                android:src="@drawable/ic_skip_next"
                app:tint="@color/textPrimary" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
