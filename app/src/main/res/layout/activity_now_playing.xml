<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingHorizontal="22dp"
    android:paddingTop="16dp"
    android:paddingBottom="20dp">

    <!-- Top bar: back · "Now Playing" · add to playlist -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/npBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="Back"
            android:padding="11dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/textPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Now Playing"
            android:textColor="@color/textPrimary"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/npAddToPlaylist"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="Add to playlist"
            android:padding="11dp"
            android:src="@drawable/ic_playlist_add"
            app:tint="@color/textPrimary" />
    </LinearLayout>

    <!-- Artwork: glowing halo + slowly spinning circular cover -->
    <FrameLayout
        android:id="@+id/npArtContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:id="@+id/npGlow"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_art_glow" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/npArtCard"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/surfaceElevated"
            app:cardCornerRadius="125dp"
            app:cardElevation="18dp"
            app:strokeColor="@color/glassStroke"
            app:strokeWidth="3dp">

            <ImageView
                android:id="@+id/npArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="60dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music_note" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <TextView
        android:id="@+id/npTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="marquee"
        android:gravity="center"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:textColor="@color/textPrimary"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/npArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/textSecondary"
        android:textSize="14sp" />

    <SeekBar
        android:id="@+id/npSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:progressTint="@color/accent"
        android:thumbTint="@color/accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/npElapsed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0:00"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/npDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Transport controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/npShuffle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Shuffle"
            android:padding="10dp"
            android:src="@drawable/ic_shuffle"
            app:tint="@color/textSecondary" />

        <ImageButton
            android:id="@+id/npPrev"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="Previous"
            android:padding="15dp"
            android:src="@drawable/ic_skip_previous"
            app:tint="@color/textPrimary" />

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginHorizontal="12dp">

            <!-- Pulsing ring behind the play button while music plays -->
            <View
                android:id="@+id/npPulse"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_pulse_ring" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/npPlayPauseCard"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="@color/accent"
                app:cardCornerRadius="38dp"
                app:cardElevation="10dp"
                app:strokeColor="@color/glassStroke"
                app:strokeWidth="2dp">

                <ImageButton
                    android:id="@+id/npPlayPause"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:contentDescription="Play or pause"
                    android:padding="20dp"
                    android:src="@drawable/ic_play"
                    app:tint="@color/onAccent" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <ImageButton
            android:id="@+id/npNext"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="Next"
            android:padding="15dp"
            android:src="@drawable/ic_skip_next"
            app:tint="@color/textPrimary" />

        <ImageButton
            android:id="@+id/npRepeat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Repeat"
            android:padding="10dp"
            android:src="@drawable/ic_repeat"
            app:tint="@color/textSecondary" />
    </LinearLayout>

    <!-- Volume -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <ImageView
            android:id="@+id/npVolumeIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Mute"
            android:padding="9dp"
            android:src="@drawable/ic_volume_up"
            app:tint="@color/textPrimary" />

        <SeekBar
            android:id="@+id/npVolumeSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_volume_up"
            app:tint="@color/textSecondary" />
    </LinearLayout>

</LinearLayout>
