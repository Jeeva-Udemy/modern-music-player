<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_now_playing"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/npBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_chip"
            android:padding="10dp"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@color/textPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Now Playing"
            android:textColor="@color/textPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="42dp"
            android:layout_height="42dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="270dp"
            android:layout_height="270dp"
            android:layout_gravity="center"
            app:cardCornerRadius="135dp"
            app:cardElevation="16dp"
            app:strokeColor="@color/accent"
            app:strokeWidth="2dp">

            <ImageView
                android:id="@+id/npArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/surfaceElevated"
                android:padding="60dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music_note" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <TextView
        android:id="@+id/npTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textColor="@color/textPrimary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/npArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/textSecondary"
        android:textSize="14sp" />

    <SeekBar
        android:id="@+id/npSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:progressTint="@color/accent"
        android:thumbTint="@color/accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/npShuffle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_shuffle"
            app:tint="@color/textSecondary" />

        <ImageButton
            android:id="@+id/npPrev"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@color/textPrimary" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginHorizontal="16dp"
            app:cardBackgroundColor="@color/accent"
            app:cardCornerRadius="36dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp">

            <ImageButton
                android:id="@+id/npPlayPause"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:padding="18dp"
                android:src="@android:drawable/ic_media_play"
                app:tint="@color/textPrimary" />
        </com.google.android.material.card.MaterialCardView>

        <ImageButton
            android:id="@+id/npNext"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_next"
            app:tint="@color/textPrimary" />

        <ImageButton
            android:id="@+id/npRepeat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_repeat"
            app:tint="@color/textSecondary" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/npAddToPlaylist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingVertical="12dp"
        android:text="Add to Playlist"
        android:textAllCaps="false"
        android:textStyle="bold"
        app:backgroundTint="@color/accentSecondary"
        app:cornerRadius="16dp" />

</LinearLayout>
